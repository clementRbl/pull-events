# === LLM et embeddings (obligatoire) ===
# Fournisseur : mistral (défaut) ou azure_openai
# LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key
# LLM_MODEL=ministral-8b-latest
# LLM_TEMPERATURE=0.3
# Plafonds par réponse : tokens générés et délai d'attente (secondes)
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_SECONDS=60
# EMBEDDING_MODEL=mistral-embed
# EMBEDDING_SIZE=1024
# TOP_K=5

# Prix en dollars par million de tokens, pour le coût par réponse
# (vérifiez les tarifs actuels sur https://mistral.ai/pricing)
# LLM_INPUT_PRICE_PER_MTOK=0.10
# LLM_OUTPUT_PRICE_PER_MTOK=0.10
# EMBEDDING_PRICE_PER_MTOK=0.10

# === Azure OpenAI (si LLM_PROVIDER=azure_openai) ===
# LLM_MODEL et EMBEDDING_MODEL contiennent alors les noms des *déploiements*
# créés dans la ressource Azure OpenAI. Changer d'embeddings impose de
# réindexer : text-embedding-3-small produit des vecteurs de 1536 dimensions.
# AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com/
# Clé facultative : sans elle, authentification par identité Entra ID
# (identité managée sur Azure, `az login` sur le poste), avec le rôle
# « Cognitive Services OpenAI User » sur la ressource.
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_API_VERSION=2024-10-21
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_SIZE=1536

# === Protection de l'API ===
# Avec API_KEY, /ask et /rebuild exigent l'en-tête X-API-Key. Sans API_KEY,
# l'API est ouverte à tous (un avertissement s'affiche au démarrage) :
# acceptable sur le poste local seulement.
# Générer une clé : openssl rand -hex 32
# API_KEY=
# /rebuild est désactivé par défaut ; true pour l'autoriser (poste local).
# ENABLE_REBUILD=false

# === Juge de l'évaluation Ragas (scripts/evaluate_rag.py uniquement) ===
# Un modèle d'un autre fournisseur note les réponses du RAG.
ANTHROPIC_API_KEY=your_anthropic_api_key
# JUDGE_PROVIDER=anthropic   # ou mistral
# JUDGE_MODEL=claude-haiku-5-5

# === Base vectorielle PostgreSQL + pgvector ===
# Hors Docker (scripts lancés avec uv run). Dans Docker Compose, l'API
# reçoit automatiquement l'adresse du conteneur db.
DATABASE_URL=postgresql+psycopg://pullevents:pullevents@localhost:5432/pullevents
# VECTOR_TABLE=event_chunks
# HNSW_EF_SEARCH=100
# POSTGRES_PASSWORD=pullevents

# === Langfuse (observabilité) ===
# Sans ces deux clés, l'API fonctionne mais ne trace rien.
# Les questions et réponses sont envoyées à Langfuse. Pour ne garder que les
# mesures (tokens, coût, latence) : LANGFUSE_TRACE_CONTENT=false
# LANGFUSE_TRACE_CONTENT=true
# Version Azure : projet Langfuse Cloud, région UE (LANGFUSE_BASE_URL=https://cloud.langfuse.com).
# Ces valeurs correspondent au projet créé au premier démarrage
# du Langfuse local (docker compose up -d).
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_BASE_URL=http://localhost:3000

# Compte de l'interface Langfuse locale (http://localhost:3000)
# LANGFUSE_INIT_USER_EMAIL=admin@pull-events.local
# LANGFUSE_INIT_USER_PASSWORD=local-dev-password

# Secrets internes de Langfuse : à changer hors poste de développement
# (générer avec : openssl rand -hex 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
